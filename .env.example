# ============================================================
# Environment template — PLACEHOLDER VALUES ONLY
# Copy to `.env` and fill with real values locally. Never commit `.env`.
# No real secrets are stored in this repository.
# ============================================================

# Backend runtime
ENVIRONMENT=development
SECRET_KEY=CHANGE_ME_PLACEHOLDER
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# PostgreSQL connection (Docker/local)
DATABASE_URL=postgresql+psycopg2://CHANGE_ME_USER:CHANGE_ME_PASSWORD@localhost:5432/CHANGE_ME_DB

# JWT authentication
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_SECRET_KEY=CHANGE_ME_PLACEHOLDER

# CORS — comma-separated allowed dashboard origins
CORS_ORIGINS=http://localhost:3000

# ML
ML_MODEL_VERSION=v1